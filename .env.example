# Copy to .env for local development. Choose your own values before hosting.
HOST_PASSWORD=change-this-host-password
SESSION_SECRET=replace-this-with-at-least-32-random-characters
PORT=3000
DATA_DIR=.data/local
# For local testing on phones, open the host app using your LAN IP.
# Azure settings are supplied by infra/main.bicep:
# NODE_ENV=production
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=quiz
# PUBLIC_ORIGIN=https://<app>.azurewebsites.net
